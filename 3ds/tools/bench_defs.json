{
  "version": 1,
  "note": "Read by 3ds/tools/bench.py. One entry per bench. kind: azahar_pic | azahar_stream | host_test | console_prof. host (console_prof): azahar | o3ds | n3ds | host (o3dsxl is read as o3ds). scenario: the azt_scenarios.json name (azahar kinds run it; console kinds copy its switches as a reference). cap in s. until: the log regex the build prints (copied from the scenario). log_metrics: regex with one capture group, pick last|first. gates: {metric, op, value} or {metric, op, ref: baseline} (baseline = earliest run of the bench with the metric). scene_match: substring of the prof scene key (null = all runs). legacy: scenarios no bench uses (status stays in azt_scenarios.json, not deleted). speed: turbo | normal, the speed the bench runs at (bench.py run --speed overrides it for one run; azt.ps1 -Speed). Azahar benches: normal (no scenario runs -Turbo today). Console and host benches: normal. Queries use it as the default.",
  "push_base": "audiostat texstat pacestat logstat",
  "consoles": {
    "o3ds": "192.168.1.131"
  },
  "benches": [
    {
      "name": "boot_mem",
      "kind": "azahar_stream",
      "speed": "normal",
      "purpose": "Boot with no warp: boot options line and the memory line (linear and heap KB).",
      "scenario": "boot_opts",
      "cap": 30,
      "until": "options: boot dz_cs=",
      "tags": [
        "azahar",
        "boot",
        "memory"
      ],
      "log_metrics": [
        {
          "name": "linear_kb",
          "regex": "memory: linear (\\d+)KB",
          "pick": "last"
        },
        {
          "name": "heap_kb",
          "regex": "memory: linear \\d+KB, heap (\\d+)KB",
          "pick": "last"
        }
      ],
      "gates": [
        {
          "metric": "linear_kb",
          "op": ">",
          "value": 0
        }
      ]
    },
    {
      "name": "toad_standing",
      "kind": "console_prof",
      "speed": "normal",
      "purpose": "Toad Town street, Mario standing at pos -264 20 -326, prof mode: the baseline of frame_budget.md.",
      "scene_match": "mac_01 m4 sp-107 b0 e0",
      "recipe": "warp=mac_01:0 story=ch0_toad_town pos=-264:20:-326 prof=4 loglevel=debug",
      "scenario": "prof_scene",
      "host": "o3ds",
      "cap": 60,
      "until": "prof f\\d+ w300 fps",
      "tags": [
        "console",
        "prof",
        "standing"
      ],
      "gates": [
        {
          "metric": "fps",
          "op": ">=",
          "ref": "baseline"
        },
        {
          "metric": "ft_ms",
          "op": "<=",
          "ref": "baseline"
        }
      ]
    },
    {
      "name": "toad_walk",
