      "recipe": "preset=toad padscript=wait80,START*3,wait615,START*3 prof=4 phase loglevel=debug",
      "scenario": "pause_menu",
      "host": "o3ds",
      "cap": 60,
      "until": "phase W f2[3-9]\\d-",
