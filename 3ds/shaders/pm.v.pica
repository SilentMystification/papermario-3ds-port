; One multiply. 2D batches upload screen pixels and Mtx_OrthoTilt.
; 3D batches upload object-space vertices and the F3DEX matrix composed
; with the viewport and that same tilt. The rasterizer divides by w.

.fvec projection[4]
.fvec uvx ; S25: second texture coordinates = uv * uvx.xy + uvx.zw
.fvec nzo ; PT07: noise coordinates = ndc * nzo.xy + nzo.zw (nzo.xy: pixels per axis / 64, nzo.zw: a random offset per frame)

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias zeros myconst.xxxx

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inuv v1
.alias inclr v2

.proc main
	; Each configured output component is written once. A second write freezes the PICA.
	; inpos.w is 1 for object-space vertices. A clipped vertex keeps its clip w.
	dp4 r4.x, projection[0], inpos
	dp4 r4.y, projection[1], inpos
	dp4 r4.z, projection[2], inpos
	dp4 r4.w, projection[3], inpos
	mov outpos, r4
	rcp r5, r4.w
	mul r5.xy, r4.xy, r5.xy
	mul r5.xy, nzo.xy, r5.xy
	add outtc2.xy, nzo.zw, r5.xy
	mov outtc2.zw, zeros
	mov outclr, inclr
	mov outtc0.xy, inuv.xy
	mov outtc0.zw, zeros
	mul r0.xy, uvx.xy, inuv.xy
	add outtc1.xy, uvx.zw, r0.xy
	mov outtc1.zw, zeros
	end
.end
