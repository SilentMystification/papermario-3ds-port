; Positions are already clip-space. One write of outpos.

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias zeros myconst.xxxx
.alias ones myconst.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inuv v1
.alias inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	mov outpos, r0
	mov outclr, inclr
	mov outtc0.xy, inuv.xy
	mov outtc0.zw, zeros
.end
