; One matrix. The PICA framebuffer is stored rotated, so clip x/y are swapped
; after the game transform: N64 +x (right) becomes GPU +y, N64 +y (up) becomes GPU -x.

.fvec mvp[4]

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inuv v1
.alias inclr v2

.constf consts(0.0, 1.0, 0.00392156862745, 0.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, mvp[0], r0
	dp4 r1.y, mvp[1], r0
	dp4 r1.z, mvp[2], r0
	dp4 r1.w, mvp[3], r0
	mov outpos.x, -r1.y
	mov outpos.y, r1.x
	mov outpos.z, r1.z
	mov outpos.w, r1.w
	mul r2, inv255, inclr
	mov outclr, r2
	mov outtc0.xy, inuv.xy
	mov outtc0.zw, zeros
.end
