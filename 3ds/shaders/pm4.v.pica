; GV1c: raw Vtx path with a matrix palette (switch gv1). v0 = ob x y z palette index (short x4), v1 = tc s t (short x2), v2 = cn r g b a (ubyte x4).
; pal[k] = the 4 rows of (OrthoTilt x viewport x game matrix k). The index k is in the flag field of the Vtx copy in the ring.
; Same output as pm3.v.pica. uvso: uv = tc * uvso.xy + uvso.zw.

.fvec pal[84]
.fvec uvx
.fvec uvso
.fvec cmul ; colour = vertex colour * cmul + cadd (overrides: ENV, plan constant, alpha 255, boost)
.fvec cadd
.fvec nzo ; PT07: noise coordinates = ndc * nzo.xy + nzo.zw
.fvec zmix ; z = z * zmix.x + w * zmix.y (G_ZS_PRIM: x 0, y = prim depth; else x 1, y 0)

.constf myconst(0.0, 1.0, 0.00392156862745098, 4.0)
.alias zeros myconst.xxxx
.alias ones myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inuv v1
.alias inclr v2

.entry main4
.proc main4
	mul r8.x, myconst.w, inpos.w
	mova a0.x, r8.x
	mov r1.xyz, inpos
	mov r1.w, ones
	dp4 r5.x, pal[a0.x], r1
	dp4 r5.y, pal[a0.x+1], r1
	dp4 r5.z, pal[a0.x+2], r1
	dp4 r5.w, pal[a0.x+3], r1
	mov outpos.x, r5.x
	mov outpos.y, r5.y
	mul r6.x, zmix.x, r5.z
	mul r7.x, zmix.y, r5.w
	add outpos.z, r6.x, r7.x
	mov outpos.w, r5.w
	rcp r4, r5.w
	mul r4.xy, r5.xy, r4.xy
	mul r4.xy, nzo.xy, r4.xy
	add outtc2.xy, nzo.zw, r4.xy
	mov outtc2.zw, zeros
	mul r3, inv255, inclr
	mul r3, cmul, r3
	add outclr, cadd, r3
	mul r0.xy, uvso.xy, inuv.xy
	add r0.xy, uvso.zw, r0.xy
	mov outtc0.xy, r0.xy
	mov outtc0.zw, zeros
	mul r2.xy, uvx.xy, r0.xy
	add outtc1.xy, uvx.zw, r2.xy
	mov outtc1.zw, zeros
	end
.end
