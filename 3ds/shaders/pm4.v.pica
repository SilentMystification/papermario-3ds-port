; GV1c: raw Vtx path with a matrix palette (switch gv1). v0 = ob x y z palette index (short x4), v1 = tc s t (short x2), v2 = cn r g b a (ubyte x4).
; pal[k] = the 4 rows of (OrthoTilt x viewport x game matrix k). The index k is in the flag field of the Vtx copy in the ring.
; Same output as pm3.v.pica. uvso: uv = tc * uvso.xy + uvso.zw.

; STEREO: eye.x = e, the signed NDC shift of this eye (0 in a mono frame). eyd.xyz = column 0 of the post matrix (gv_post: N64 clip x to PICA
; clip), eyd.w = cw, the clip w with zero parallax (conv x nd_proj_wn, EYECW). A palette entry with a perspective w row (w row xyz not 0) moves
; by e * (w - cw) along N64 clip x: pos.xyz += eyd.xyz * e * (w - cw). eye and eyd come first in both programs (the same registers in pm4 and pm5).
.fvec eye
.fvec eyd
.fvec pal[84]
; uvso, cmul, cadd and zmix are 4 registers in a row: nd_emit_draw writes them as one block (pm_gpu.c checks the locations at init)
.fvec uvso
.fvec cmul ; colour = vertex colour * cmul + cadd (overrides: ENV, plan constant, alpha 255, boost)
.fvec cadd
.fvec zmix ; z = z * zmix.x + w * zmix.y (G_ZS_PRIM: x 0, y = prim depth; else x 1, y 0)
.fvec uvx
.fvec nzo ; PT07: noise coordinates = ndc * nzo.xy + nzo.zw

.constf myconst(0.0, 1.0, 0.00392156862745098, 4.0)
.alias zeros myconst.xxxx
.alias ones myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inuv v1
.alias inclr v2

.entry main4
.proc main4
	mul r8.x, myconst.w, inpos.w
	mova a0.x, r8.x
	mov r1.xyz, inpos
	mov r1.w, ones
	dp4 r5.x, pal[a0.x], r1
	dp4 r5.y, pal[a0.x+1], r1
	dp4 r5.z, pal[a0.x+2], r1
	dp4 r5.w, pal[a0.x+3], r1
	; STEREO: the eye shift (0 in a mono frame: e = 0 adds nothing)
	mov r9, pal[a0.x+3]
	dp3 r9.x, r9, r9
	slt r9.x, myconst.xxxx, r9.x
	add r10.x, -eyd.wwww, r5.wwww
	mul r10.x, r9.xxxx, r10.xxxx
	mul r10.x, eye.xxxx, r10.xxxx
	mad r5.xyz, r10.xxxx, eyd, r5
	mov outpos.x, r5.x
	mov outpos.y, r5.y
	mul r6.x, zmix.x, r5.z
	mul r7.x, zmix.y, r5.w
	add r6.x, r6.x, r7.x
	; FFOREST: z = min(z, -w / 65025) (eps = 1/255 squared, about 2^-16). N64 rejects only a whole triangle past far and clamps the vertex
	; z; the PICA would cut the triangle at the far plane. A vertex past far lands on the far plane (depth eps, passes GREATER over the cleared 0).
	mul r7.x, myconst.zzzz, r5.w
	mul r7.x, -myconst.zzzz, r7.x
	min r6.x, r6.x, r7.x
	mov outpos.z, r6.x
	mov outpos.w, r5.w
	rcp r4, r5.w
	mul r4.xy, r5.xy, r4.xy
	mul r4.xy, nzo.xy, r4.xy
	add outtc2.xy, nzo.zw, r4.xy
	mov outtc2.zw, zeros
	mul r3, inv255, inclr
	mul r3, cmul, r3
	add outclr, cadd, r3
	mul r0.xy, uvso.xy, inuv.xy
	add r0.xy, uvso.zw, r0.xy
	mov outtc0.xy, r0.xy
	mov outtc0.zw, zeros
	mul r2.xy, uvx.xy, r0.xy
	add outtc1.xy, uvx.zw, r2.xy
	mov outtc1.zw, zeros
	end
.end
