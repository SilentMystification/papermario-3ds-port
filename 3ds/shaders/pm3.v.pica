; PO3b: raw Vtx path (switch gpuvtx). v0 = ob x y z flag (short x4), v1 = tc s t (short x2), v2 = cn r g b a (ubyte x4).
; One matrix per batch: projection = the game matrix (row vectors, transposed) composed with the viewport and the tilt, as in pm.v.pica.
; Uniform order is the same as pm.v.pica (projection, uvx) so the register numbers match. uvso is new: uv = tc * uvso.xy + uvso.zw.

.fvec projection[4]
.fvec uvx
.fvec uvso

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias zeros myconst.xxxx
.alias ones myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inuv v1
.alias inclr v2

.proc main
	mov r1.xyz, inpos
	mov r1.w, ones
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mul outclr, inv255, inclr
	mul r0.xy, uvso.xy, inuv.xy
	add r0.xy, uvso.zw, r0.xy
	mov outtc0.xy, r0.xy
	mov outtc0.zw, zeros
	mul r2.xy, uvx.xy, r0.xy
	add outtc1.xy, uvx.zw, r2.xy
	mov outtc1.zw, zeros
	end
.end
