; PO3b: raw Vtx path (switch gpuvtx). v0 = ob x y z flag (short x4), v1 = tc s t (short x2), v2 = cn r g b a (ubyte x4).
; One matrix per batch: projection = the game matrix (row vectors, transposed) composed with the viewport and the tilt, as in pm.v.pica.
; Uniform order is the same as pm.v.pica (projection, uvx) so the register numbers match. uvso is new: uv = tc * uvso.xy + uvso.zw.

.fvec projection[4]
.fvec uvx
.fvec uvso
.fvec cmul ; PO3c: colour = vertex colour * cmul + cadd (overrides: ENV, plan constant, alpha 255, boost)
.fvec cadd
.fvec zmix ; PO3c: z = z * zmix.x + w * zmix.y (G_ZS_PRIM: x 0, y = prim depth; else x 1, y 0)

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias zeros myconst.xxxx
.alias ones myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inuv v1
.alias inclr v2

.proc main
	mov r1.xyz, inpos
	mov r1.w, ones
	dp4 r5.x, projection[0], r1
	dp4 r5.y, projection[1], r1
	dp4 r5.z, projection[2], r1
	dp4 r5.w, projection[3], r1
	mov outpos.x, r5.x
	mov outpos.y, r5.y
	mul r6.x, zmix.x, r5.z
	mul r7.x, zmix.y, r5.w
	add outpos.z, r6.x, r7.x
	mov outpos.w, r5.w
	mul r3, inv255, inclr
	mul r3, cmul, r3
	add outclr, cadd, r3
	mul r0.xy, uvso.xy, inuv.xy
	add r0.xy, uvso.zw, r0.xy
	mov outtc0.xy, r0.xy
	mov outtc0.zw, zeros
	mul r2.xy, uvx.xy, r0.xy
	add outtc1.xy, uvx.zw, r2.xy
	mov outtc1.zw, zeros
	end
.end
