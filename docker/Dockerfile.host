# Host test image for the native draw harness (3ds/tools/nd_host_test.sh): 32-bit gcc for the game producer files (pointers cast to u32).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc-multilib libc6-dev-i386 python3 binutils make && rm -rf /var/lib/apt/lists/*
