diff --git a/3ds/tools/nd_ndev_rec_test.c b/3ds/tools/nd_ndev_rec_test.c
new file mode 100644
index 0000000..9018b2c
--- /dev/null
+++ b/3ds/tools/nd_ndev_rec_test.c
@@ -0,0 +1,22 @@
+/* NTABFIND host test: nd_ndev_pack (nd_gtab.h) keeps the record-time NdNDev when its owner clears the entry before core 0 runs the record
+ * (imgfx.c imgfx_cache_instance_data sets gfxDev[i].list to NULL). Case 0: the copy survives the clear. Case 1: the words gt_run reads. */
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include "common.h"
+#include "nd_gtab.h"
+
+int main(void) {
+    static uint32_t buf[8] = { 0x01020304u, 0x05060708u };
+    NdNDev e = { buf, 0u, buf, 3u, 2u };
+    uint32_t rec[2u * ND_NDEV_REC_UNITS];
+    NdNDev d;
+    memset(rec, 0, sizeof rec);
+    nd_ndev_pack(rec, &e, 0x00123456u);
+    e.list = NULL; e.u = NULL; e.nu = 0u; e.ntri = 0u; /* the owner clears the entry (imgfx.c:476) */
+    nd_ndev_unpack(&d, rec);
+    if (d.list != (const void*)buf || d.u != buf || d.nu != 3u || d.ntri != 2u || d.fl != 0u) { printf("ndev FAIL case 0\n"); return 1; }
+    if (rec[1] != 0u || rec[2] != 0x00123456u || rec[3] != 0u) { printf("ndev FAIL case 1\n"); return 1; }
+    printf("ndev ok\n");
+    return 0;
+}
diff --git a/3ds/tests/host.d/ntabfind.sh b/3ds/tests/host.d/ntabfind.sh
new file mode 100644
index 0000000..9d88c42
--- /dev/null
+++ b/3ds/tests/host.d/ntabfind.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+# NTABFIND: nd_ndev_pack (nd_gtab.h) copies a built NdNDev into its record. The seed (the record holds the entry address) must fail case 0.
+F="-DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -D_MIPS_SZLONG=32 -I include -I src -I ver/us/build/include -I 3ds/include -I 3ds/stub_include"
+mkdir -p /tmp/ntabfind_seed
+sed 's/memcpy(rec + 4, e, sizeof \*e);/memcpy(rec + 4, \&e, sizeof e);/' 3ds/include/nd_gtab.h > /tmp/ntabfind_seed/nd_gtab.h
+if cmp -s 3ds/include/nd_gtab.h /tmp/ntabfind_seed/nd_gtab.h; then echo "ntabfind seed FAIL: the sed changed nothing"; exit 1; fi
+gcc -m32 -w -I /tmp/ntabfind_seed $F -o /tmp/ntabfind_seed/t 3ds/tools/nd_ndev_rec_test.c || exit 1
+got=$(/tmp/ntabfind_seed/t); if [ "$got" != "ndev FAIL case 0" ]; then echo "ntabfind seed FAIL: got [$got]"; exit 1; fi
+gcc -m32 -Wall -Wextra $F -o /tmp/ntabfind_t 3ds/tools/nd_ndev_rec_test.c && /tmp/ntabfind_t || exit 1
+echo "ntabfind ok"
