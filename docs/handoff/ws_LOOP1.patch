diff --git a/3ds/tools/rowloop.sh b/3ds/tools/rowloop.sh
new file mode 100644
index 0000000000..a2637977b0
--- /dev/null
+++ b/3ds/tools/rowloop.sh
@@ -0,0 +1,45 @@
+#!/bin/sh
+# rowloop.sh --row R --bench B[,B2] [--why TEXT] [--no-host]: the row loop in one call (docs/handoff/plan_fastloop.md, row LOOP1).
+# The host test and the lane build run at the same time. Then one bench run (a list runs on one kept Azahar) and one cmp per
+# bench against the merge-base of HEAD and main. A cmp that reports a cold start runs the bench once more (TOOLB9).
+# Outputs: build3ds/out/loop_<R>_{host,build,run,cmp_<bench>}.txt. Stdout: a summary of 12 lines or fewer. Exit 0 only when
+# every step passed. --no-host skips the host test (a page that ran it already for this tree).
+set -u
+cd "$(dirname "$0")/../.." || exit 2
+R=; B=; W="row loop"; H=1
+while [ $# -gt 0 ]; do
+    case $1 in
+        --row) R=$2; shift 2 ;; --bench) B=$2; shift 2 ;; --why) W=$2; shift 2 ;; --no-host) H=0; shift ;;
+        *) echo "rowloop: unknown argument $1"; exit 2 ;;
+    esac
+done
+[ -n "$R" ] && [ -n "$B" ] || { echo "usage: sh 3ds/tools/rowloop.sh --row R --bench B[,B2] [--why TEXT] [--no-host]"; exit 2; }
+O=build3ds/out; mkdir -p $O; P=$O/loop_$R
+export PM_ROW=$R PM_LANE=$R
+PY=python; command -v python >/dev/null 2>&1 || PY=python3
+t0=$(date +%s); hrc=0; brc=0
+if [ "$H" = 1 ]; then sh 3ds/tools/nd_host_test.sh > ${P}_host.txt 2>&1 & hp=$!; fi
+sh 3ds/build.sh > ${P}_build.txt 2>&1 || brc=$?
+if [ "$H" = 1 ]; then wait $hp || hrc=$?; fi
+t1=$(date +%s)
+echo "LOOP $R host rc $hrc, build rc $brc, $((t1 - t0)) s"
+[ "$H" = 1 ] && grep -h -E "^(ND HOST TESTS|hostcache:|host.d FAILED|FAIL )" ${P}_host.txt | head -4
+grep -h -E "^STAGE|BUILD (FAILED|FAULT|TIMEOUT)|up to date" ${P}_build.txt | tr '\n' ' ' | cut -c1-400; echo
+if [ "$hrc" != 0 ] || [ "$brc" != 0 ]; then echo "LOOP FAIL: read ${P}_host.txt and ${P}_build.txt (last 20 lines)"; exit 1; fi
+BASE=$(git merge-base HEAD main)
+crc=0
+run_cmp() {
+    $PY 3ds/tools/bench.py run "$B" --row "$R" --why "$W" > ${P}_run.txt 2>&1 || return 1
+    crc=0
+    for b in $(echo "$B" | tr ',' ' '); do
+        $PY 3ds/tools/bench.py cmp "$b" --row "$R" --commit "$BASE" > ${P}_cmp_$b.txt 2>&1 || crc=1
+    done
+    return 0
+}
+run_cmp || { echo "LOOP FAIL: bench run, read ${P}_run.txt"; exit 1; }
+if grep -l "cold start (warm 0)" ${P}_cmp_*.txt >/dev/null 2>&1; then run_cmp || { echo "LOOP FAIL: bench run 2, read ${P}_run.txt"; exit 1; }; fi
+t2=$(date +%s)
+for b in $(echo "$B" | tr ',' ' '); do echo "cmp $b: $(grep -h -E "byte-equal|void|DIFF|missing|no stored base" ${P}_cmp_$b.txt | tr '\n' ' ' | cut -c1-200)"; done
+echo "LOOP TIME host+build $((t1 - t0)) s, run+cmp $((t2 - t1)) s, total $((t2 - t0)) s"
+[ "$crc" = 0 ] && { echo "LOOP PASS"; exit 0; }
+echo "LOOP FAIL: cmp, read ${P}_cmp_<bench>.txt"; exit 1
