diff --git a/3ds/tools/gencache.sh b/3ds/tools/gencache.sh
new file mode 100644
--- /dev/null
+++ b/3ds/tools/gencache.sh
@@ -0,0 +1,125 @@
+#!/bin/sh
+# GENCACHE (VOLGEN): the shared store of the generator outputs of 3ds/build.sh, one store for every worktree and lane:
+# <main folder>/build3ds/gencache/<gen>/<16 hex of sha1(key)>/. Cache safety (docs/handoff/plan_buildspeed.md):
+# - the key is a text of content hashes of every input (tool and source files, ROM, asset files, image id, command text);
+# - an entry holds key.txt (the full key), out.sha1 (the sha1 of each stored file) and the files; every use checks both,
+#   and a failed entry is removed (a miss);
+# - a new entry is a temp folder that one mv renames: no half entry.
+# PM_CACHE=off: no read, no write. PM_CACHE=check (cachecheck): every get misses; every put compares the new files with the
+# entry of the same key and prints "cachecheck <gen> ok" or "CACHECHECK FAIL <gen>" (the entry is then replaced, GC_FAIL=1).
+# Needs MAIN_ROOT (or GENCACHE_DIR) and OUT. Host self-test: 3ds/tests/host.d/volgen.sh.
+GC_ROOT=${GENCACHE_DIR:-$MAIN_ROOT/build3ds/gencache}
+GC_FAIL=0
+# Files under the key paths that are no input of a generator: pm_build.h is written after the generators and read only by
+# 3ds/src/pm_main.c, pm_options.c and pm_wdog.c; the other 3 are generator outputs (gen_pso_tab adds the 2 gfx outputs itself).
+GC_EXCL="3ds/include/pm_build.h 3ds/src/nd_pso_tab.c 3ds/src/nd_gfx_tab.c 3ds/src/nd_ntab_descs.c"
+
+gc_dir() { printf '%s/%s/%s' "$GC_ROOT" "$1" "$(printf '%s' "$2" | sha1sum | cut -c1-16)"; }
+
+# gc_ok <entry dir> <key>: 0 when the entry holds this key and every file matches out.sha1. A failed entry is removed.
+gc_ok() {
+    [ -d "$1" ] || return 1
+    if [ -f "$1/key.txt" ] && [ "$(cat "$1/key.txt")" = "$2" ] && [ -s "$1/out.sha1" ] && (cd "$1" && sha1sum -c --status out.sha1 2>/dev/null); then
+        return 0
+    fi
+    echo "gencache: entry $1 failed its check (key or file hash), removed" >&2
+    rm -rf "$1"
+    return 1
+}
+
+# gc_inputs <path>...: the lines of $OUT/in_now.txt (src_sync.sh in_manifest) under the paths, without GC_EXCL.
+gc_inputs() {
+    awk -F'\t' -v L="$*" -v X="$GC_EXCL" 'BEGIN { n = split(L, a, " "); m = split(X, x, " "); for (i = 1; i <= m; i++) ex[x[i]] = 1 }
+        ($1 in ex) { next } { for (i = 1; i <= n; i++) if ($1 == a[i] || index($1, a[i] "/") == 1) { print; next } }' "$OUT/in_now.txt"
+}
+
+# gc_get <gen> <key> <name:path>...: on a hit 0, and each stored file is copied to its path (an equal file is not touched).
+gc_get() {
+    g=$1; k=$2; shift 2
+    case "${PM_CACHE:-on}" in off|check) return 1 ;; esac
+    d=$(gc_dir "$g" "$k")
+    gc_ok "$d" "$k" || return 1
+    for p in "$@"; do [ -f "$d/${p%%:*}" ] || { rm -rf "$d"; return 1; }; done
+    for p in "$@"; do
+        f=${p#*:}
+        mkdir -p "$(dirname "$f")"
+        cmp -s "$d/${p%%:*}" "$f" || cp -f "$d/${p%%:*}" "$f"
+    done
+    return 0
+}
+
+# gc_check <gen> <entry dir> <0|1 equal>: the cachecheck line of one compare.
+gc_check() {
+    if [ "$3" = 1 ]; then echo "cachecheck $1 ok" >&2; return 0; fi
+    echo "CACHECHECK FAIL $1: the entry $2 differs from a cold run, replaced" >&2
+    GC_FAIL=1
+    rm -rf "$2"
+}
+
+# gc_put <gen> <key> <name:path>...: stores the files under the key. 1 when a file is missing (nothing stored).
+gc_put() {
+    g=$1; k=$2; shift 2
+    [ "${PM_CACHE:-on}" = off ] && return 0
+    d=$(gc_dir "$g" "$k")
+    if [ "${PM_CACHE:-on}" = check ]; then
+        if [ -d "$d" ]; then
+            eq=1; gc_ok "$d" "$k" || eq=0
+            if [ "$eq" = 1 ]; then for p in "$@"; do cmp -s "$d/${p%%:*}" "${p#*:}" || eq=0; done; fi
+            gc_check "$g" "$d" "$eq"
+        else
+            echo "cachecheck $g: no entry for this key" >&2
+        fi
+    fi
+    [ -d "$d" ] && return 0
+    t="$d.tmp.$$"; rm -rf "$t"; mkdir -p "$t" || return 1
+    for p in "$@"; do f=${p#*:}; [ -f "$f" ] || { rm -rf "$t"; return 1; }; cp -f "$f" "$t/${p%%:*}"; done
+    printf '%s' "$k" > "$t/key.txt"
+    (cd "$t" && for p in "$@"; do sha1sum "${p%%:*}"; done > out.sha1)
+    mv -T "$t" "$d" 2>/dev/null || rm -rf "$t"
+    gc_trim "$g"
+    return 0
+}
+
+# gc_get_dir <gen> <key> <dest dir> <marker file>: on a hit 0, and <dest dir> holds hard links (else copies) of the entry files.
+# The marker names the entry; a dest dir with that marker and the same file count is kept as it is.
+gc_get_dir() {
+    case "${PM_CACHE:-on}" in off|check) return 1 ;; esac
+    d=$(gc_dir "$1" "$2")
+    gc_ok "$d" "$2" || return 1
+    e=$(basename "$d"); n=$(grep -c . "$d/out.sha1")
+    if [ "$(cat "$4" 2>/dev/null)" = "$e" ] && [ "$(ls -A "$3" 2>/dev/null | wc -l | tr -d ' ')" = "$n" ]; then return 0; fi
+    rm -rf "$3"; mkdir -p "$3"
+    cp -l "$d"/f/* "$3"/ 2>/dev/null || cp -f "$d"/f/* "$3"/
+    printf '%s' "$e" > "$4"
+    return 0
+}
+
+# gc_put_dir <gen> <key> <src dir> <marker file>: stores every file of <src dir> under the key (hard links, else copies).
+gc_put_dir() {
+    d=$(gc_dir "$1" "$2")
+    [ "${PM_CACHE:-on}" = off ] && return 0
+    if [ "${PM_CACHE:-on}" = check ]; then
+        if [ -d "$d" ]; then
+            eq=1; gc_ok "$d" "$2" || eq=0
+            [ "$eq" = 1 ] && { diff -r -q "$d/f" "$3" >/dev/null 2>&1 || eq=0; }
+            gc_check "$1" "$d" "$eq"
+        else
+            echo "cachecheck $1: no entry for this key" >&2
+        fi
+    fi
+    if [ ! -d "$d" ]; then
+        t="$d.tmp.$$"; rm -rf "$t"; mkdir -p "$t/f" || return 1
+        cp -l "$3"/* "$t/f/" 2>/dev/null || cp -f "$3"/* "$t/f/"
+        printf '%s' "$2" > "$t/key.txt"
+        (cd "$t" && sha1sum f/* > out.sha1)
+        mv -T "$t" "$d" 2>/dev/null || rm -rf "$t"
+        gc_trim "$1"
+    fi
+    [ -d "$d" ] && printf '%s' "$(basename "$d")" > "$4"
+    return 0
+}
+
+# gc_trim <gen>: keeps the newest GENCACHE_KEEP (default 12) entries of the gen.
+gc_trim() {
+    ls -1dt "$GC_ROOT/$1"/*/ 2>/dev/null | grep -v '\.tmp\.' | tail -n +$((${GENCACHE_KEEP:-12} + 1)) | while read -r x; do rm -rf "$x"; done
+}
diff --git a/3ds/tools/src_sync.sh b/3ds/tools/src_sync.sh
new file mode 100644
--- /dev/null
+++ b/3ds/tools/src_sync.sh
@@ -0,0 +1,87 @@
+#!/bin/sh
+# SRCSYNC (VOLGEN): the content manifests and the source volume of a lane. Sourced by 3ds/build.sh (VOLHOST: also by
+# 3ds/tools/nd_host_test.sh). Needs: OUT, IMG, SRCVOL, CODE_DIRS, ASSET_BASE, ASSET_DIRS (asset_manifest sets AHASH and AVOL).
+# The lane source volume holds the code only. The assets live in one shared volume per asset content, pm3ds-assets-<16 hex>,
+# linked into /src by two symlinks (/src/assets/us, /src/ver/us/build -> /a/c/...). Every id here is a content hash, never a
+# time or a size (plan_buildspeed.md "Cache safety"). Host self-test: 3ds/tests/srcsync/run.sh.
+
+# in_manifest <path>...: "path<TAB>id" of every file under the paths, sorted. id b:<blob> for a tracked file equal to the
+# index (git ls-files -s), h:<git hash-object --no-filters> for every other file (modified, untracked, ignored).
+# PM_BUILD_REV (an archive folder with the GIT_DIR of the main folder: the index is not this tree): every file gets h:.
+in_manifest() {
+    im=$OUT/.inm.$$
+    : > $im.b; : > $im.h; : > $im.d
+    if [ -n "$PM_BUILD_REV" ]; then
+        find "$@" -type f | grep -v -E '(^|/)__pycache__/|\.pyc$|\.tmp\.' | LC_ALL=C sort > $im.h
+    else
+        git -c core.quotepath=off ls-files -s -- "$@" | awk '{ i = index($0, "\t"); print substr($0, i + 1) "\tb:" $2 }' > $im.b
+        git -c core.quotepath=off ls-files -m -o -- "$@" | grep -v -E '(^|/)__pycache__/|\.pyc$|\.tmp\.' | LC_ALL=C sort -u > $im.mo || true
+        while IFS= read -r f; do if [ -f "$f" ]; then printf '%s\n' "$f" >> $im.h; else printf '%s\n' "$f" >> $im.d; fi; done < $im.mo
+    fi
+    if [ -s $im.h ]; then git hash-object --no-filters --stdin-paths < $im.h | paste $im.h - | sed 's/\t/\th:/' > $im.hh; else : > $im.hh; fi
+    awk -F'\t' 'FILENAME == ARGV[1] { del[$1] = 1; next } { id[$1] = $2 } END { for (p in id) if (!(p in del)) print p "\t" id[p] }' \
+        $im.d $im.b $im.hh | LC_ALL=C sort
+    rm -f $im.b $im.mo $im.h $im.d $im.hh
+}
+
+# asset_manifest: writes $OUT/asset_now.txt ("path<TAB>h:<blob>" of every asset file, sorted) and sets AHASH (its sha1) and
+# AVOL (the shared asset volume of this content). PM_CACHE=off: AVOL is a new volume of this run (removed at the end).
+asset_manifest() {
+    oa=$(cd "$OUT" && pwd)
+    (cd "$ASSET_BASE" && find $ASSET_DIRS -type f | LC_ALL=C sort > "$oa/asset_paths.txt" \
+        && git hash-object --no-filters --stdin-paths < "$oa/asset_paths.txt" | paste "$oa/asset_paths.txt" - > "$oa/asset_now.txt")
+    [ -s "$OUT/asset_now.txt" ] || { echo "asset_manifest: no asset files under $ASSET_BASE ($ASSET_DIRS)" >&2; exit 1; }
+    AHASH=$(sha1sum < "$OUT/asset_now.txt" | cut -c1-40)
+    AVOL=pm3ds-assets-$(printf '%s' "$AHASH" | cut -c1-16)
+    if [ "${PM_CACHE:-on}" = off ]; then AVOL=pm3ds-assets-cold$$; fi
+}
+
+# vol_state: one container reads the source volume id (line 1) and prints "assets-ok" when the asset volume holds this key.
+vol_state() {
+    MSYS_NO_PATHCONV=1 docker run --rm -v $SRCVOL:/src -v $AVOL:/a -e K=$AHASH $IMG sh -c \
+        'cat /src/.pm_manifest_id 2>/dev/null; echo; [ -d /a/c ] && [ "$(cat /a/c/key.txt 2>/dev/null)" = "$K" ] && echo assets-ok; true'
+}
+# vol_match: the manifest is valid only while the volume id and $OUT/src_volid.txt match (g tag: a content-id sync, VOLGEN).
+vol_match() { case "$VOLID" in g*) ;; *) return 1 ;; esac; [ "$VOLID" = "$(cat $OUT/src_volid.txt 2>/dev/null)" ]; }
+
+# asset_vol_make: fills the asset volume once: the files, key.txt and out.sha1 go to a temp folder that one mv names /a/c.
+asset_vol_make() {
+    u="t$$_$(date +%s)"
+    (cd "$ASSET_BASE" && tar -cf - $ASSET_DIRS) | MSYS_NO_PATHCONV=1 docker run --rm -i -v $AVOL:/a -e U=$u -e K=$AHASH $IMG sh -c '
+        set -e
+        if [ -d /a/c ] && [ "$(cat /a/c/key.txt 2>/dev/null)" != "$K" ]; then mv /a/c /a/bad.$U; rm -rf /a/bad.$U; fi
+        mkdir -p /a/$U/c; tar -xf - -C /a/$U/c
+        (cd /a/$U/c && find assets ver -type f | LC_ALL=C sort | xargs -d "\n" sha1sum) > /a/$U/c/out.sha1
+        printf %s "$K" > /a/$U/c/key.txt
+        mv -T /a/$U/c /a/c 2>/dev/null || true
+        rm -rf /a/$U'
+    # The assets must not change during the copy: a second hash after it, a change removes the volume.
+    a1=$AHASH; asset_manifest
+    if [ "$a1" != "$AHASH" ]; then docker volume rm $AVOL >/dev/null 2>&1; echo "asset files changed during the copy: build again" >&2; exit 1; fi
+    echo "asset volume $AVOL made" >&2
+}
+
+# src_sync: makes the lane source volume equal to the code manifest. Sets SYNCID, writes $OUT/src_manifest2.txt.
+src_sync() {
+    MAN=$OUT/src_manifest2.txt
+    # No id match: a new volume (a volume of an older sync can hold files that the manifest does not name).
+    if vol_match; then SYNCID=$VOLID; else rm -f $MAN; SYNCID="g$(date +%s)_$$"; docker volume rm $SRCVOL >/dev/null 2>&1 || true; fi
+    [ -f $MAN ] || : > $MAN
+    [ "$AOK" = 1 ] || asset_vol_make
+    in_manifest $CODE_DIRS > $OUT/src_now.txt
+    awk -F'\t' 'FILENAME==ARGV[1]{old[$1]=$2; next} (old[$1] != $2){print $1}' $MAN $OUT/src_now.txt > $OUT/src_changed.txt
+    awk -F'\t' 'FILENAME==ARGV[1]{now[$1]=1; next} !($1 in now){print $1}' $OUT/src_now.txt $MAN > $OUT/src_deleted.txt
+    nchg=$(wc -l < $OUT/src_changed.txt); ndel=$(wc -l < $OUT/src_deleted.txt)
+    if [ -s $OUT/src_changed.txt ]; then
+        # STALEOBJ: -m stamps each copied file with the copy time, so it is newer than every object in the build volume.
+        tar -cf - -T $OUT/src_changed.txt | MSYS_NO_PATHCONV=1 docker run --rm -i -v $SRCVOL:/src -e S="$SYNCID" $IMG sh -c '
+            tar -xmf - -C /src
+            for p in assets/us ver/us/build; do [ -L /src/$p ] || rm -rf /src/$p; mkdir -p /src/${p%/*}; ln -sfn /a/c/$p /src/$p; done
+            printf %s "$S" > /src/.pm_manifest_id'
+    fi
+    if [ -s $OUT/src_deleted.txt ]; then
+        MSYS_NO_PATHCONV=1 docker run --rm -i -v $SRCVOL:/src $IMG sh -c 'while read -r f; do rm -f "/src/$f"; done' < $OUT/src_deleted.txt
+    fi
+    cp -f $OUT/src_now.txt $MAN
+    echo "$SYNCID" > $OUT/src_volid.txt
+}
diff --git a/3ds/tests/host.d/volgen.sh b/3ds/tests/host.d/volgen.sh
new file mode 100644
--- /dev/null
+++ b/3ds/tests/host.d/volgen.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+# VOLGEN: self-test of the generator cache 3ds/tools/gencache.sh (cache safety rule 4, plan_buildspeed.md). Seeded faults: one
+# changed input byte, one changed stored byte, a key.txt of another key, one changed byte in a dir entry, PM_CACHE=off, and a
+# cachecheck compare. Each fault must give a miss (or a CACHECHECK FAIL). Prints "volgen gencache ok", exit 1 on a failure.
+set -e
+T=/tmp/volgen; rm -rf $T; mkdir -p $T/out
+OUT=$T/out; GENCACHE_DIR=$T/store; MAIN_ROOT=$T; PM_CACHE=on
+. 3ds/tools/gencache.sh
+fail() { echo "volgen FAIL $1"; exit 1; }
+key() { printf 'gen t v1\nin %s' "$(sha1sum < $T/in1 | cut -c1-40)"; }
+printf 'a\n' > $T/in1; printf 'x1\n' > $T/o1.txt
+k1=$(key)
+gc_get t "$k1" o1.txt:$T/r1.txt && fail "hit on an empty store"
+gc_put t "$k1" o1.txt:$T/o1.txt
+gc_get t "$k1" o1.txt:$T/r1.txt || fail "miss after put"
+cmp -s $T/r1.txt $T/o1.txt || fail "a hit copied other bytes"
+printf 'b\n' > $T/in1; k2=$(key)
+gc_get t "$k2" o1.txt:$T/r1.txt && fail "one changed input byte gave a hit"
+d=$(gc_dir t "$k1"); printf 'x2\n' > $d/o1.txt
+gc_get t "$k1" o1.txt:$T/r1.txt 2>/dev/null && fail "a changed stored byte gave a hit"
+[ -d "$d" ] && fail "a failed entry was kept"
+gc_put t "$k1" o1.txt:$T/o1.txt; printf '%s' "$k2" > $d/key.txt
+gc_get t "$k1" o1.txt:$T/r1.txt 2>/dev/null && fail "a key.txt of another key gave a hit"
+mkdir -p $T/sd; for i in 1 2 3; do printf "s$i\n" > $T/sd/f$i.nds; done
+gc_put_dir s "$k1" $T/sd $T/m0
+gc_get_dir s "$k1" $T/ld $T/m1 || fail "dir miss after put"
+diff -r -q $T/sd $T/ld >/dev/null || fail "a dir hit copied other bytes"
+dd=$(gc_dir s "$k1"); rm -f $dd/f/f2.nds; printf 'zz\n' > $dd/f/f2.nds
+gc_get_dir s "$k1" $T/ld $T/m1 2>/dev/null && fail "a changed byte in a dir entry gave a hit"
+PM_CACHE=off; gc_put t "$k2" o1.txt:$T/o1.txt; PM_CACHE=on
+gc_get t "$k2" o1.txt:$T/r1.txt && fail "PM_CACHE=off stored an entry"
+gc_put t "$k2" o1.txt:$T/o1.txt
+PM_CACHE=check; gc_get t "$k2" o1.txt:$T/r1.txt && fail "PM_CACHE=check gave a hit"
+gc_put t "$k2" o1.txt:$T/o1.txt 2>/dev/null; [ "$GC_FAIL" = 0 ] || fail "cachecheck of equal bytes failed"
+printf 'x3\n' > $T/o1.txt; gc_put t "$k2" o1.txt:$T/o1.txt 2>/dev/null; [ "$GC_FAIL" = 1 ] || fail "cachecheck missed a changed output"
+PM_CACHE=on
+echo "volgen gencache ok"
