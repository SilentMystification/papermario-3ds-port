+#!/bin/sh
+# GCONVW: the own-TU split of gen_gfx_syms.py. The fixture (3ds/tests/gconvw/w.c, namespace tw) gives one TU file; it must equal
+# exp_tu0.c (written by hand). GCONVSPLIT: a TU file is gconv_tu_<source path, other characters as _>.c. CR bytes are dropped first: the generator and the checkout differ in line endings on Windows (mechanical fix, FXREST1). The seeded fault (DEF without the N(x) form) must differ. The TU object needs the gconv_sym section.
+F="-DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -DVERSION=us -D_MIPS_SZLONG=32 -Dnullptr=NULL"
+INC="-I 3ds/tools/gconv_inc -I 3ds/tools -I 3ds/include -I 3ds/stub_include -I include -I src -I assets/us -I ver/us/build/include -I ."
+rm -rf /tmp/gcw && mkdir -p /tmp/gcw/f
+python3 3ds/tools/gen_gfx_syms.py /tmp/gcw/gconv_in.c 3ds/tests/gconvw/w.c > /tmp/gcw/tus.txt || { echo "gconvw FAIL gen"; exit 1; }
+TU=gconv_tu_3ds_tests_gconvw_w_c.c # GCONVSPLIT: the TU name of 3ds/tests/gconvw/w.c
+[ "$(cat /tmp/gcw/tus.txt)" = "/tmp/gcw/$TU" ] || { echo "gconvw FAIL tu list"; exit 1; }
+tr -d '\r' < /tmp/gcw/$TU > /tmp/gcw/tu0.n && tr -d '\r' < 3ds/tests/gconvw/exp_tu0.c > /tmp/gcw/exp.n && cmp /tmp/gcw/tu0.n /tmp/gcw/exp.n || { echo "gconvw FAIL tu0 differs"; exit 1; }
+gcc -m32 -w -ffunction-sections -fdata-sections $F $INC -c -o /tmp/gcw/gconv_tu0.o /tmp/gcw/$TU || { echo "gconvw FAIL compile"; exit 1; }
+readelf -S /tmp/gcw/gconv_tu0.o | grep -q "gconv_sym" || { echo "gconvw FAIL no gconv_sym section"; exit 1; }
+# seeded fault: a copy of the tool whose DEF lacks the N(x) form (the empty alternative keeps the group count) must differ
+python3 - <<'PY' || { echo "gconvw FAIL seeded fault not applied"; exit 1; }
+t = open("3ds/tools/gen_gfx_syms.py").read()
+old = r"(?:N\((\w+)\)|(\w+))\s*\[[^\]]*\]\s*="
+assert t.count(old) == 1
+open("/tmp/gcw/gen_fault.py", "w").write(t.replace(old, r"(?:()|(\w+))\s*\[[^\]]*\]\s*="))
+PY
+python3 /tmp/gcw/gen_fault.py /tmp/gcw/f/gconv_in.c 3ds/tests/gconvw/w.c > /dev/null 2>&1
+if [ ! -f /tmp/gcw/f/$TU ] || cmp -s /tmp/gcw/f/$TU 3ds/tests/gconvw/exp_tu0.c; then echo "gconvw FAIL seeded fault not seen"; exit 1; fi
+# AXNS: NAMESPACE A(x) names a list AREA_x_<name> (fixture made here). Seeded fault: AREA_RULE off gives the name A(actor)_dl.
+R=$(pwd); W=/tmp/gcw3; rm -rf $W && mkdir -p $W/b/a $W/o $W/f
+printf '#define AREA b_area_t\n' > $W/b/area.h
+printf '#include "../area.h"\n#define NAMESPACE A(actor)\nGfx N(dl)[] = {\n    gsSPEndDisplayList(),\n};\n' > $W/b/a/x.c
+(cd $W && python3 "$R/3ds/tools/gen_gfx_syms.py" o/gconv_in.c b/a/x.c > /dev/null) || { echo "gconvw FAIL area gen"; exit 1; }
+grep -q '"b_area_t_actor_dl", GS_GFX' $W/o/gconv_tu_b_a_x_c.c || { echo "gconvw FAIL area name"; exit 1; }
+sed 's/^AREA_RULE = True/AREA_RULE = False/' "$R/3ds/tools/gen_gfx_syms.py" > $W/gen_fault.py
+cmp -s $W/gen_fault.py "$R/3ds/tools/gen_gfx_syms.py" && { echo "gconvw FAIL area seeded fault not applied"; exit 1; }
+(cd $W && python3 gen_fault.py f/gconv_in.c b/a/x.c > /dev/null 2>&1)
+grep -q '"b_area_t_actor_dl", GS_GFX' $W/f/gconv_tu_b_a_x_c.c 2>/dev/null && { echo "gconvw FAIL area seeded fault not seen"; exit 1; }
+# GMERLEE: a twin whose first line includes the includer (dro_02/npc.c includes npc_merlee.c): the symbols come from the device file of the twin path.
+# Seeded fault: the source from the first line (top.c) lacks part_gfx.
+R=$(pwd); W=/tmp/gcw4; rm -rf $W && mkdir -p $W/t $W/3ds/tools/gfxin/t $W/o $W/f
+printf 'int top_val;\n#include "part.c"\n' > $W/t/top.c
+printf 'Gfx part_gfx[] = {\n    gsSPEndDisplayList(),\n};\n' > $W/t/part.c
+printf '#include "t/top.c"\n' > $W/3ds/tools/gfxin/t/part.c
+(cd $W && python3 "$R/3ds/tools/gen_gfx_syms.py" o/gconv_in.c 3ds/tools/gfxin/t/part.c > /dev/null) || { echo "gconvw FAIL twin gen"; exit 1; }
+grep -q '"part_gfx", GS_GFX' $W/o/gconv_tu_3ds_tools_gfxin_t_part_c.c || { echo "gconvw FAIL twin device symbol"; exit 1; }
+sed 's/^    src = pathlib.Path(s\[len(TWIN):\])  # GMERLEE.*/    src = pathlib.Path(m.group(1))/' "$R/3ds/tools/gen_gfx_syms.py" > $W/gen_fault.py
+cmp -s $W/gen_fault.py "$R/3ds/tools/gen_gfx_syms.py" && { echo "gconvw FAIL twin seeded fault not applied"; exit 1; }
+(cd $W && python3 gen_fault.py f/gconv_in.c 3ds/tools/gfxin/t/part.c > /dev/null 2>&1)
+grep -q '"part_gfx", GS_GFX' $W/f/gconv_tu_3ds_tools_gfxin_t_part_c.c 2>/dev/null && { echo "gconvw FAIL twin seeded fault not seen"; exit 1; }
+# GCONVSPLIT: two sources with one TU name (a/b.c and a_b.c give gconv_tu_a_b_c.c) must stop the tool.
+W=/tmp/gcw5; rm -rf $W && mkdir -p $W/a $W/o
+printf 'int x1;' > $W/a/b.c; printf 'int x2;' > $W/a_b.c
+(cd $W && python3 "$R/3ds/tools/gen_gfx_syms.py" o/gconv_in.c a/b.c a_b.c > /dev/null 2>&1) && { echo "gconvw FAIL TU name clash not seen"; exit 1; }
+echo "gconvw ok"
