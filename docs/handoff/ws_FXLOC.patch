+def name_uses(s, n):
+    """The uses of the name n in s. A struct member of the same name (`.n`, `->n`) is not a use."""
+    return [u for u in re.finditer(r"\b%s\b" % re.escape(n), s) if not re.search(r"(?:\.|->)\s*$", s[max(0, u.start() - 3):u.start()])]
+
+
+def line_of(s, u):
+    ls = s.rfind("\n", 0, u.start()) + 1
+    le = s.find("\n", u.end())
+    return s[ls:u.start()], s[u.end():le if le >= 0 else len(s)]
+
+
+def array_use_ok(s, u, locs):
+    pre, post = line_of(s, u)
+    if re.search(r"ARRAY_COUNT\(\s*$", pre) and re.match(r"\s*\)", post):
+        return True
+    if not post.startswith("["):
+        return False
+    if re.search(r"(?:nd_draw_list\(\s*|gSPDisplayList\(\s*gMainGfxPos\+\+,\s*|nd_rec_dl\(\s*|NDCTL_CALL\(\s*\w+,\s*)$", pre):
+        return True
+    if re.match(r"\[[^\[\]\n]*(?:\[[^\[\]\n]*\][^\[\]\n]*)*\]" + CMP, post):
+        return True
+    a = re.search(r"(?:^|[;{])\s*(?:Gfx\*\s+)?(\w+)\s*=\s*$", pre)
+    return bool(a) and a.group(1) in locs
+
+
+def local_use_ok(s, u, arrs):
+    pre, post = line_of(s, u)
+    if re.search(r"nd_draw_list\(\s*$", pre) and re.match(r"\s*,", post):
+        return True
+    if re.search(CALL_END, pre) and re.match(r"\s*\)", post):
+        return True
+    if re.match(CMP, post):
+        return True
+    if not re.match(r"^\s*(?:Gfx\*\s+)?$", pre):
+        return False
+    if pre.strip() == "Gfx*" and re.match(r"\s*;", post):
+        return True
+    v = re.match(r"\s*=\s*(\w+)\s*([\[(])", post)
+    return bool(v) and ((v.group(2) == "[" and v.group(1) in arrs) or (v.group(2) == "(" and v.group(1) == "NDN"))
+
+
+def local_scan(t):
+    """--local: (ok array matches, all array matches, ok locals, the offsets of every `Gfx*` to rewrite)."""
+    s = blank(t)
+    decls = list(DECL.finditer(s))
+    at = {m.start(2) for m in decls}
+    arrs = {m.group(2) for m in decls if any(u.start() not in at for u in name_uses(s, m.group(2)))}
+    locs = set(re.findall(r"\bGfx\*\s+(\w+)\s*[;=]", s)) - {m.group(2) for m in decls}
+    while True:
+        bad_a = {n for n in arrs if not all(array_use_ok(s, u, locs) for u in name_uses(s, n) if u.start() not in at)}
+        bad_l = {n for n in locs if not all(local_use_ok(s, u, arrs) for u in name_uses(s, n))} if LOCAL_RULE else set()
+        if not bad_a and not bad_l:
+            break
+        arrs -= bad_a
+        locs -= bad_l
+    locs = {n for n in locs if re.search(r"\b%s\s*=\s*(?:\w+\s*\[|NDN\()" % re.escape(n), s)}
+    ok = [m for m in decls if m.group(2) in arrs]
+    edits = [m.start() + len(m.group(1) or "") for m in ok]
+    for n in locs:
+        edits.extend(d.start() for d in re.finditer(r"\bGfx\*(?=\s+%s\s*[;=])" % re.escape(n), s))
+    return ok, decls, locs, sorted(set(edits))
