diff --git a/3ds/include/nd_gbi.h b/3ds/include/nd_gbi.h
index cc63c4c7cb..75295b0cd0 100644
--- a/3ds/include/nd_gbi.h
+++ b/3ds/include/nd_gbi.h
@@ -46,6 +46,10 @@ Gfx* nd_rec_task(void);
 #define gsDPSetCombineLERP(a0, b0, c0, d0, Aa0, Ab0, Ac0, Ad0, a1, b1, c1, d1, Aa1, Ab1, Ac1, Ad1) \
     ND_GS(ND_W0_CMB(a0, b0, c0, d0, Aa0, Ab0, Ac0, Ad0, a1, b1, c1, d1, Aa1, Ab1, Ac1, Ad1), \
           ND_W1_CMB(a0, b0, c0, d0, Aa0, Ab0, Ac0, Ad0, a1, b1, c1, d1, Aa1, Ab1, Ac1, Ad1))
+/* WSCMB: a combine unit (or a no-op unit) as an NdCmbW value (include/common_structs.h); the words of gsDPSetCombineMode and gsDPNoOp */
+#define ND_CMB_W_(w0, w1) { ND_X0(w0, w1), ND_X1(w0, w1) }
+#define ND_CMB_W(...) ND_CMB_W_(ND_W0_CMB(__VA_ARGS__), ND_W1_CMB(__VA_ARGS__))
+#define ND_CMB_NOP ND_CMB_W_(ND_W0_NP(G_NOOP), 0)
 #undef gDPSetColor
 #define gDPSetColor(pkt, c, d) ND_GX(pkt, _SHIFTL(c, 24, 8), (unsigned int)(d))
 #undef gsDPSetColor
diff --git a/3ds/tests/host.d/wscmb.sh b/3ds/tests/host.d/wscmb.sh
new file mode 100644
index 0000000000..5b90e0d62c
--- /dev/null
+++ b/3ds/tests/host.d/wscmb.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+# WSCMB: the window style combine values (ND_CMB_W, ND_CMB_NOP) equal the gsDPSetCombineMode and gsDPNoOp words, all 18 pairs in use.
+# Seeded fault: -DWSCMB_SEED changes one word; the test must then fail.
+F="-DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -DVERSION=us -D_MIPS_SZLONG=32 -Dnullptr=NULL -I include -I ver/us/build/include -I 3ds/include -I 3ds/stub_include -I src"
+gcc -m32 -w $F -o /tmp/wscmb 3ds/tests/wscmb/wscmb.c || { echo "wscmb FAIL compile"; exit 1; }
+/tmp/wscmb || { echo "wscmb FAIL"; exit 1; }
+gcc -m32 -w $F -DWSCMB_SEED -o /tmp/wscmb_seed 3ds/tests/wscmb/wscmb.c || { echo "wscmb FAIL seed compile"; exit 1; }
+if /tmp/wscmb_seed > /dev/null; then echo "wscmb FAIL seeded fault not seen"; exit 1; fi
+echo "wscmb ok"
diff --git a/3ds/tests/wscmb/wscmb.c b/3ds/tests/wscmb/wscmb.c
new file mode 100644
index 0000000000..f8f321b45d
--- /dev/null
+++ b/3ds/tests/wscmb/wscmb.c
@@ -0,0 +1,53 @@
+/* WSCMB: ND_CMB_W and ND_CMB_NOP (3ds/include/nd_gbi.h) give the words of gsDPSetCombineMode and gsDPNoOp for every pair the window styles use. -DWSCMB_SEED changes one word (the seeded fault). */
+#include "common.h"
+#include <stdio.h>
+static const Gfx g[] = {
+    gsDPNoOp(),
+    gsDPSetCombineMode(PM_CC_14, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_15, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_2B, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_2C, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_30, PM_CC_BOX2_CYC2),
+    gsDPSetCombineMode(PM_CC_31, PM_CC_BOX2_CYC2),
+    gsDPSetCombineMode(PM_CC_BOX1_OPAQUE, PM_CC_BOX1_CYC2),
+    gsDPSetCombineMode(PM_CC_BOX1_TRANSPARENT, PM_CC_BOX1_CYC2),
+    gsDPSetCombineMode(PM_CC_BOX2_OPAQUE, PM_CC_BOX2_CYC2),
+    gsDPSetCombineMode(PM_CC_BOX2_TRANSPARENT, PM_CC_BOX2_CYC2),
+    gsDPSetCombineMode(PM_CC_CONST_0, PM_CC_CONST_0),
+    gsDPSetCombineMode(PM_CC_WINDOW_2, PM_CC_WINDOW_1),
+    gsDPSetCombineMode(PM_CC_WINDOW_3, PM_CC_WINDOW_1),
+    gsDPSetCombineMode(PM_CC_WINDOW_4, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_WINDOW_5, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_WINDOW_6, G_CC_PASS2),
+    gsDPSetCombineMode(PM_CC_WINDOW_7, G_CC_PASS2),
+};
+static NdCmbW n[] = {
+    ND_CMB_NOP,
+    ND_CMB_W(PM_CC_14, G_CC_PASS2),
+    ND_CMB_W(PM_CC_15, G_CC_PASS2),
+    ND_CMB_W(PM_CC_2B, G_CC_PASS2),
+    ND_CMB_W(PM_CC_2C, G_CC_PASS2),
+    ND_CMB_W(PM_CC_30, PM_CC_BOX2_CYC2),
+    ND_CMB_W(PM_CC_31, PM_CC_BOX2_CYC2),
+    ND_CMB_W(PM_CC_BOX1_OPAQUE, PM_CC_BOX1_CYC2),
+    ND_CMB_W(PM_CC_BOX1_TRANSPARENT, PM_CC_BOX1_CYC2),
+    ND_CMB_W(PM_CC_BOX2_OPAQUE, PM_CC_BOX2_CYC2),
+    ND_CMB_W(PM_CC_BOX2_TRANSPARENT, PM_CC_BOX2_CYC2),
+    ND_CMB_W(PM_CC_CONST_0, PM_CC_CONST_0),
+    ND_CMB_W(PM_CC_WINDOW_2, PM_CC_WINDOW_1),
+    ND_CMB_W(PM_CC_WINDOW_3, PM_CC_WINDOW_1),
+    ND_CMB_W(PM_CC_WINDOW_4, G_CC_PASS2),
+    ND_CMB_W(PM_CC_WINDOW_5, G_CC_PASS2),
+    ND_CMB_W(PM_CC_WINDOW_6, G_CC_PASS2),
+    ND_CMB_W(PM_CC_WINDOW_7, G_CC_PASS2),
+};
+int main(void) {
+    unsigned bad = 0, i;
+#ifdef WSCMB_SEED
+    n[1].w1 ^= 1u;
+#endif
+    for (i = 0; i < sizeof g / sizeof g[0]; i++)
+        if (g[i].words.w0 != n[i].w0 || g[i].words.w1 != n[i].w1) { printf("wscmb differ %u: %08x %08x vs %08x %08x\n", i, (unsigned)g[i].words.w0, (unsigned)g[i].words.w1, (unsigned)n[i].w0, (unsigned)n[i].w1); bad++; }
+    printf("wscmb %u pairs bad %u\n", i, bad);
+    return bad != 0;
+}
