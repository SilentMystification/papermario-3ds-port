diff --git a/3ds/include/nd_st.h b/3ds/include/nd_st.h
index bee3d788aa..d922630978 100644
--- a/3ds/include/nd_st.h
+++ b/3ds/include/nd_st.h
@@ -8,6 +8,9 @@
 #include "nd_gbi.h"
 
 void nd_pso_comb(uint32_t w0, uint32_t w1);
+/* GFXPOS7: one typed unit as ND_CMB_W or ND_CMB_NOP stores it (nd_gbi.h; draw_box.c gBoxCombineModes, the window styles). The no-op unit
+ * records nothing; any other unit is one native record. The same stream as nd_gx_w(gMainGfxPos++, x0, x1) of a state unit. */
+void nd_pso_unit(uint32_t x0, uint32_t x1);
 #define nd_pso_cc(...) nd_pso_comb(ND_W0_CMB(__VA_ARGS__), ND_W1_CMB(__VA_ARGS__))
 
 /* G_SETOTHERMODE_H / _L (gbi.h gDPSet*): the mode words */
diff --git a/3ds/src/nd_st.c b/3ds/src/nd_st.c
index 94540d29e2..d52651d119 100644
--- a/3ds/src/nd_st.c
+++ b/3ds/src/nd_st.c
@@ -14,6 +14,10 @@
 void nd_pso_comb(uint32_t w0, uint32_t w1) {
     NDST_COMB(nd_nr, w0, w1);
 }
+void nd_pso_unit(uint32_t x0, uint32_t x1) {
+    if (x0 == ND_NOP_A) return; /* nd_gx_w drops a no-op unit (nd_rec.c IS_NOP) */
+    nd_nr(x0, x1);
+}
 void nd_pso_rm(unsigned c0, unsigned c1) {
     NDST_RM(nd_nr, c0, c1);
 }
diff --git a/3ds/tests/host.d/stunit.sh b/3ds/tests/host.d/stunit.sh
index d125237941..20fc2fa180 100644
--- a/3ds/tests/host.d/stunit.sh
+++ b/3ds/tests/host.d/stunit.sh
@@ -1,6 +1,6 @@
 #!/bin/sh
 # STUNIT: host test of the state calls (nd_st.c) against the macros they replace (3ds/tools/nd_st_test.c).
-# Prints "stunit ok 18/18" or "stunit FAIL <shape>". First a seeded fault (the cyc shift changed in a copy of nd_st.c) must fail at cyc; then the real link must pass.
+# Prints "stunit ok 20/20" or "stunit FAIL <shape>". First a seeded fault (the cyc shift changed in a copy of nd_st.c) must fail at cyc; then the real link must pass.
 FP="-msse2 -mfpmath=sse -ffp-contract=off"
 FL="-m32 -Wall -DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -D_MIPS_SZLONG=32 -I include -I ver/us/build/include -I 3ds/include -I 3ds/stub_include"
 RO=/tmp # HOSTD2: read-only inputs that nd_host_test.sh makes before the host.d loop; the batch rule does not count $RO paths
@@ -14,5 +14,9 @@ LIBS_RS=$(echo "$LIBS" | sed 's#3ds/src/nd_rec.c#/tmp/nd_rec_seed.c#')
 gcc $FL $FP -o /tmp/stunit_rseed 3ds/tools/nd_st_test.c 3ds/src/nd_st.c $LIBS_RS || exit 1
 got=$(/tmp/stunit_rseed)
 if [ "$got" != "stunit FAIL run" ]; then echo "stunit run seed FAIL: got [$got], want [stunit FAIL run]"; exit 1; fi
+sed 's/if (x0 == ND_NOP_A) return;/(void)0;/' 3ds/src/nd_st.c > /tmp/nd_st_useed.c # GFXPOS7: nd_pso_unit records the no-op unit
+gcc $FL $FP -o /tmp/stunit_useed 3ds/tools/nd_st_test.c /tmp/nd_st_useed.c $LIBS || exit 1
+got=$(/tmp/stunit_useed)
+if [ "$got" != "stunit FAIL unop" ]; then echo "stunit unit seed FAIL: got [$got], want [stunit FAIL unop]"; exit 1; fi
 gcc $FL $FP -o /tmp/stunit 3ds/tools/nd_st_test.c 3ds/src/nd_st.c $LIBS || exit 1
 /tmp/stunit || exit 1
