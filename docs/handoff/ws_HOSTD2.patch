diff --git a/3ds/tests/host.d/geounit.sh b/3ds/tests/host.d/geounit.sh
index d521c8072b..45d800c65b 100644
--- a/3ds/tests/host.d/geounit.sh
+++ b/3ds/tests/host.d/geounit.sh
@@ -3,7 +3,8 @@
 # Prints "geounit ok 13/13" or "geounit FAIL <shape>". First a seeded fault (the zsrc shift changed in a copy of nd_geo.c) must fail at zsrc; then the real link must pass.
 FP="-msse2 -mfpmath=sse -ffp-contract=off"
 FL="-m32 -Wall -DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -D_MIPS_SZLONG=32 -I include -I ver/us/build/include -I 3ds/include -I 3ds/stub_include"
-LIBS="3ds/src/nd_xf.c 3ds/src/nd_rec.c 3ds/src/nd_model.c 3ds/src/nd_op.c 3ds/src/nd_mtx.c 3ds/src/nd_tmpl.c /tmp/ndcomb.o /tmp/ndcombs.c /tmp/ndlogs.c -lm"
+RO=/tmp # HOSTD2: read-only inputs that nd_host_test.sh makes before the host.d loop; the batch rule does not count $RO paths
+LIBS="3ds/src/nd_xf.c 3ds/src/nd_rec.c 3ds/src/nd_model.c 3ds/src/nd_op.c 3ds/src/nd_mtx.c 3ds/src/nd_tmpl.c $RO/ndcomb.o $RO/ndcombs.c $RO/ndlogs.c -lm"
 sed 's/G_MDSFT_ZSRCSEL, 1)/G_MDSFT_ZSRCSEL, 2)/' 3ds/src/nd_geo.c > /tmp/nd_geo_seed.c
 gcc $FL $FP -o /tmp/geounit_seed 3ds/tools/nd_geo_test.c /tmp/nd_geo_seed.c $LIBS || exit 1
 got=$(/tmp/geounit_seed)
diff --git a/3ds/tests/host.d/hunit.sh b/3ds/tests/host.d/hunit.sh
index 1613f36a2b..234fed3a1c 100644
--- a/3ds/tests/host.d/hunit.sh
+++ b/3ds/tests/host.d/hunit.sh
@@ -3,7 +3,8 @@
 # Prints "hunit ok 7/7" or "hunit FAIL <shape>". First a seeded fault (env records NDO_PRIM) must fail at env; then the real link must pass.
 FP="-msse2 -mfpmath=sse -ffp-contract=off"
 FL="-m32 -Wall -DF3DEX_GBI_2 -D_LANGUAGE_C -DTARGET_3DS -DVERSION_US -D_MIPS_SZLONG=32 -I include -I ver/us/build/include -I 3ds/include -I 3ds/stub_include"
-LIBS="3ds/src/nd_xf.c 3ds/src/nd_rec.c 3ds/src/nd_model.c 3ds/src/nd_op.c 3ds/src/nd_mtx.c 3ds/src/nd_tmpl.c /tmp/ndcomb.o /tmp/ndcombs.c /tmp/ndlogs.c -lm"
+RO=/tmp # HOSTD2: read-only inputs that nd_host_test.sh makes before the host.d loop; the batch rule does not count $RO paths
+LIBS="3ds/src/nd_xf.c 3ds/src/nd_rec.c 3ds/src/nd_model.c 3ds/src/nd_op.c 3ds/src/nd_mtx.c 3ds/src/nd_tmpl.c $RO/ndcomb.o $RO/ndcombs.c $RO/ndlogs.c -lm"
 # NSTREAM3: the env record is an O form now (nd_at.h NDVAL_ENV), so the seed is a copy of nd_at.h in a first include dir.
 mkdir -p /tmp/hunit_seed_inc
 sed 's/NDO_ENV, 0u/NDO_PRIM, 0u/' 3ds/include/nd_at.h > /tmp/hunit_seed_inc/nd_at.h
