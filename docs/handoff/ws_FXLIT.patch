+#!/bin/sh
+# FXLIT: a lit draw after a light unit and the units PRIMDEPTH, SCISSOR, FILLCOLOR and RECT are units only (nd_gfx_conv.c v2_walk), so these lists are gset ok.
+# Reads /tmp/gconv of nd_host_test.sh. The old converter (main before FXLIT) fails on the first name.
+for l in D_09006C98_39F858 D_09007188_39FD48 D_8014E8F0 D_8014E9A8 kmr_20_records_screen_gfx mgm_00_Gfx_RecordDisplay_Init hos_05_gfx_setup_story_viewport D_09000570_3B9FE0; do
+  grep -qx "$l" /tmp/gconv/gset_ok.txt || { echo "fxlit FAIL: $l is not gset ok"; exit 1; }
+done
+echo "fxlit ok"
