-            m = NS_DEF.search(q.read_text(encoding="utf-8", errors="replace"))
+            qt = q.read_text(encoding="utf-8", errors="replace")
+            m = NS_DEF.search(qt)
             if m:
-                return m.group(1)
+                return area_ns(q, qt, m.group(1))
     return parent_ns
 
 
