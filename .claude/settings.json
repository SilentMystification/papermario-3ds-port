{
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "caveman@caveman": false
  },
  "hooks": {
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/docs/handoff/subagent_hook.js\"", "timeout": 5 } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python 3ds/tools/dedup_stubs.py:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(*run_azahar.ps1*)",
      "PowerShell(*3ds*build*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  }
}
